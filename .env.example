# Port configuration
PORT=3000

# MikroTik RouterOS Credentials
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin_isp
MIKROTIK_PASSWORD=sua_senha_mikrotik_aqui
